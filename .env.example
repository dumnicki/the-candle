# Copy to .env. Shell variables win over this file. Never commit .env.

# Who writes the ghost line and both replies.
#   backboard  hosted threads API (default). Pinned to open-weight Gemma 4.
#   ollama     local Ollama
#   openai     any OpenAI-compatible server (LM Studio, llama.cpp, ...)
#   mock       canned replies, no key and no model. Smoke test only.
LLM_PROVIDER=backboard

# --- Backboard (default) ---
# Docs: https://docs.backboard.io/
# The `google` provider is Gemini, not Gemma. Leave the two lines below as-is
# so the open-weight model stays at the core. Confirm the id is still listed:
#   curl "https://app.backboard.io/api/models?provider=openrouter&limit=500" \
#     -H "X-API-Key: $BACKBOARD_API_KEY"
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_LLM_PROVIDER=openrouter
BACKBOARD_MODEL=google/gemma-4-26b-a4b-it

# --- Ollama (local laptop default: Gemma 4 E4B) ---
#   ollama pull gemma4:e4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# --- OpenAI-compatible local server ---
# LM Studio's default is shown. llama.cpp server is often http://127.0.0.1:8080/v1
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=
OPENAI_MODEL=gemma4

# Optional override for OLLAMA_MODEL / OPENAI_MODEL only. Does not change Backboard.
# LLM_MODEL=gemma4:e4b

# Voice. The /api/turn route does not speak yet; this selects the provider.
#   elevenlabs  default
#   piper       stub until the open fallback is wired
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

PORT=8787
